# Copy to deploy/vikunja.env on the dev host and fill in. Never commit the real file
# (.gitignore excludes *.env).

VIKUNJA_DATABASE_TYPE=postgres
VIKUNJA_DATABASE_HOST=vikunja-db
VIKUNJA_DATABASE_DATABASE=vikunja
VIKUNJA_DATABASE_USER=vikunja
VIKUNJA_DATABASE_PASSWORD=CHANGE_ME

# Must match how the instance is reached, or the web UI builds broken links.
VIKUNJA_SERVICE_PUBLICURL=https://sw-surface.tail9803a5.ts.net:8443/

# Generate with: openssl rand -hex 32
# Do NOT reuse production's secret. A dev instance with prod's secret would accept
# prod-issued tokens, which is exactly the coupling this instance exists to avoid.
# (The old name VIKUNJA_SERVICE_JWTSECRET is deprecated in 2.5 -- use SECRET.)
VIKUNJA_SERVICE_SECRET=CHANGE_ME

# Where attachments are written inside the container; the compose file mounts the
# host's files/ directory here. Without this, Vikunja defaults to /app/vikunja/files,
# which is not writable by the container's uid and crash-loops on boot.
VIKUNJA_FILES_BASEPATH=/db

# On by default so the first account can be created, then turn it off.
VIKUNJA_SERVICE_ENABLEREGISTRATION=true

VIKUNJA_SERVICE_TIMEZONE=America/New_York
VIKUNJA_LOG_LEVEL=INFO

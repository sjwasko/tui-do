/target
**/*.rs.bk

# Compiled artifacts must never be committed. cria carries a 206 KB .rlib in its
# history; that is the mistake this line exists to prevent.
*.rlib
*.rmeta
*.so
*.dylib

# Secrets. Deploy env files live on the host at /opt/stacks/, never in the repo.
*.env
!.env.example
/deploy/*.secret

# Local state
/spec/*.tmp.json
.direnv/

# Personal Claude Code config for this checkout: plugin choices, extra permissions.
# `.claude/settings.json` is the project's own -- the rust-check hook and the cargo
# permissions everyone needs -- and belongs in the repo. This one does not, and was
# ignored only by never being added until a `git add -A` swept it into a commit.
.claude/settings.local.json
